<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="WindowTop"
    d:DesignHeight="40"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="Transparent" ClipToBounds="True">
        <!--#region TOP WINDOW BAR-->
        <!--  Creating window top bar  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,4,12,4"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            WindowChrome.IsHitTestVisibleInChrome="True">
            <!--  Minimize  -->
            <Button
                x:Name="btn_minimize"
                Width="40"
                Click="RaiseWindowMinimizeEvent"
                Style="{DynamicResource CustomButton_01}"
                ToolTip="Minimize">
                <ContentControl
                    Width="12"
                    Height="12"
                    Style="{DynamicResource IconControlStyle}"
                    Tag="{DynamicResource icon_minimise}" />
            </Button>
            <!--  Resize  -->
            <Button
                x:Name="btn_resize"
                Width="40"
                Margin="4,0,4,0"
                Click="RaiseWindowResizeEvent"
                Style="{DynamicResource CustomButton_01}"
                ToolTip="Resize">
                <ContentControl
                    Width="12"
                    Height="12"
                    IsHitTestVisible="False"
                    Style="{DynamicResource IconControlStyle}"
                    Tag="{DynamicResource icon_resize}" />
            </Button>
            <!--  Close  -->
            <Button
                x:Name="btn_close"
                Width="40"
                Click="RaiseWindowCloseEvent"
                Style="{DynamicResource CustomButton_01}"
                ToolTip="Close">
                <ContentControl
                    Width="12"
                    Height="12"
                    Style="{DynamicResource IconControlStyle}"
                    Tag="{DynamicResource icon_close}" />
            </Button>
        </StackPanel>

        <StackPanel
            Grid.Row="0"
            Margin="12,4,4,4"
            HorizontalAlignment="Left"
            Orientation="Horizontal"
            WindowChrome.IsHitTestVisibleInChrome="True">
            <!--  Theme Changer  -->
            <Button
                Width="40"
                Click="RaiseWindowThemeEvent"
                Style="{DynamicResource CustomButton_01}"
                ToolTip="Change Theme">
                <ContentControl
                    Width="{DynamicResource icon_size_20}"
                    Height="{DynamicResource icon_size_20}"
                    Style="{DynamicResource IconControlStyle}"
                    Tag="{DynamicResource icon_chai}" />
            </Button>
            <!--  Window Title  -->
            <TextBlock
                x:Name="tb_title"
                Margin="8,0,0,0"
                Style="{DynamicResource CustomTextBlock_WindowTitle}"
                Text="{Binding Title, ElementName=WindowTop}" />
        </StackPanel>
        <!--#endregion-->
    </Grid>
</UserControl>
