<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="40"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <Separator
            Margin="8,0,8,0"
            VerticalAlignment="Top"
            BorderBrush="{DynamicResource theme_separator}"
            BorderThickness="{DynamicResource thickness_border_01}" />
        <Button
            Width="200"
            Margin="0,6,0,4"
            Padding="{DynamicResource padding_01}"
            Click="RaiseWebsiteVisitEvent"
            Style="{DynamicResource CustomButton_01}">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <ContentControl
                    Width="12"
                    Height="12"
                    Style="{DynamicResource IconControlStyle}"
                    Tag="{DynamicResource icon_chai}" />
                <TextBlock
                    Margin="8,0,4,0"
                    Style="{DynamicResource CustomTextBlock_WindowFooter}"
                    Text="DEVELOPER" />
                <ContentControl
                    Width="12"
                    Height="12"
                    Style="{DynamicResource IconControlStyle}"
                    Tag="{DynamicResource icon_love}" />
                <TextBlock
                    Margin="4,0,8,0"
                    Style="{DynamicResource CustomTextBlock_WindowFooter}"
                    Text="CHAI" />
                <ContentControl
                    Width="12"
                    Height="12"
                    Style="{DynamicResource IconControlStyle}"
                    Tag="{DynamicResource icon_chai}" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
