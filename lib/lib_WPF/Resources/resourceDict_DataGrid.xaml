<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--  ******************  -->
    <!--  Style - DataGrid Cell  -->
    <Style x:Key="CustomDefaultDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource theme_datagrid_gridline}" />
        <Setter Property="Foreground" Value="{DynamicResource theme_datagrid_overall_fg}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border
                        x:Name="CellBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ******************  -->
    <!--  Style - DataGrid RowHeader  -->
    <Style x:Key="CustomDefaultDataGridRowHeaderStyle" TargetType="{x:Type DataGridRowHeader}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridRowHeader}">
                    <Grid Width="0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ******************  -->
    <!--  Style - DataGrid Row  -->
    <Style x:Key="CustomDefaultDataGridRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{DynamicResource theme_datagrid_overall_bg}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridRow}">
                    <Border
                        x:Name="DGR_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </SelectiveScrollingGrid.ColumnDefinitions>
                            <SelectiveScrollingGrid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </SelectiveScrollingGrid.RowDefinitions>

                            <DataGridCellsPresenter
                                Grid.Column="1"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                            <DataGridDetailsPresenter
                                Grid.Row="1"
                                Grid.Column="1"
                                SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                Visibility="{TemplateBinding DetailsVisibility}" />

                            <!--  Row header hidden (zero width)  -->
                            <DataGridRowHeader
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                        </SelectiveScrollingGrid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Normal rows  -->
                        <Trigger Property="AlternationIndex" Value="0">
                            <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource theme_datagrid_overall_bg}" />
                        </Trigger>
                        <!--  Alternating rows  -->
                        <Trigger Property="AlternationIndex" Value="1">
                            <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource theme_datagrid_alternate_row_bg}" />
                        </Trigger>
                        <!--  Validation error  -->
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource theme_datagrid_error_bg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ******************  -->
    <!--  Style - Column-header gripper (resize thumb)  -->
    <Style x:Key="CustomColumnHeaderGripperStyle" TargetType="{x:Type Thumb}">
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ******************  -->
    <!--  Style - DataGrid ColumnHeader  -->
    <Style x:Key="CustomDefaultDataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource theme_datagrid_header_bg}" />
        <Setter Property="Foreground" Value="{DynamicResource theme_datagrid_overall_fg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource theme_datagrid_gridline}" />
        <Setter Property="BorderThickness" Value="0,0,1,2" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid>
                        <Border
                            x:Name="HeaderBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <!--  Sort icon placeholder  -->
                                <Path
                                    x:Name="SortArrow"
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Data="M 0,4 L 4,0 L 8,4 Z"
                                    Fill="{TemplateBinding Foreground}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Visibility="Collapsed">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <Thumb
                            x:Name="PART_LeftHeaderGripper"
                            HorizontalAlignment="Left"
                            Style="{StaticResource CustomColumnHeaderGripperStyle}" />
                        <Thumb
                            x:Name="PART_RightHeaderGripper"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CustomColumnHeaderGripperStyle}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource theme_datagrid_half_selected_bg}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource theme_datagrid_selected_bg}" />
                        </Trigger>
                        <!--  Show sort arrow when a direction is set  -->
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ******************  -->
    <!--  Style - DataGrid ColumnHeadersPresenter  -->
    <Style x:Key="CustomDefaultDataGridColumnHeadersPresenterStyle" TargetType="{x:Type DataGridColumnHeadersPresenter}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeadersPresenter}">
                    <Border Background="{DynamicResource theme_datagrid_header_bg}" CornerRadius="0">
                        <Grid>
                            <DataGridColumnHeader
                                x:Name="PART_FillerColumnHeader"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                IsHitTestVisible="False"
                                SeparatorVisibility="Collapsed" />
                            <ItemsPresenter />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ******************  -->
    <!--  Drop-location indicator (column drag & drop)  -->
    <ControlTemplate x:Key="GridViewHeaderRowIndicatorTemplate" TargetType="Separator">
        <Border>
            <Rectangle
                Width="3"
                Height="18"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Fill="{DynamicResource theme_datagrid_overall_transparent}"
                RadiusX="2"
                RadiusY="2" />
        </Border>
    </ControlTemplate>

    <Style x:Key="CustomDefaultDropLocationIndicatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Width" Value="3" />
        <Setter Property="Template" Value="{StaticResource GridViewHeaderRowIndicatorTemplate}" />
    </Style>

    <!--  ******************  -->
    <!--  Main style: DataGrid  -->
    <Style x:Key="CustomDataGrid-03" TargetType="{x:Type DataGrid}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource theme_datagrid_overall_bg}" />
        <Setter Property="RowBackground" Value="{DynamicResource theme_datagrid_overall_bg}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource theme_datagrid_alternate_row_bg}" />
        <Setter Property="Foreground" Value="{DynamicResource theme_datagrid_overall_fg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource theme_border_brush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource thickness_border_01}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource theme_datagrid_gridline}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource theme_datagrid_gridline}" />
        <Setter Property="GridLinesVisibility" Value="All" />
        <Setter Property="FontSize" Value="{DynamicResource text_height_normal}" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="RowDetailsVisibilityMode" Value="Collapsed" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="ColumnHeaderHeight" Value="36" />
        <Setter Property="RowStyle" Value="{StaticResource CustomDefaultDataGridRowStyle}" />
        <Setter Property="RowHeaderStyle" Value="{StaticResource CustomDefaultDataGridRowHeaderStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource CustomDefaultDataGridCellStyle}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource CustomDefaultDataGridColumnHeaderStyle}" />
        <Setter Property="DropLocationIndicatorStyle" Value="{StaticResource CustomDefaultDropLocationIndicatorStyle}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGrid}">
                    <!--
                        Outer border gives the rounded corners and the outermost grid-line stroke.
                        ClipToBounds ensures rows don't bleed outside the rounded corners.
                    -->
                    <Border
                        x:Name="border"
                        Padding="4"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True"
                        CornerRadius="{DynamicResource corner_radius_01}"
                        SnapsToDevicePixels="True">
                        <ScrollViewer
                            x:Name="DG_ScrollViewer"
                            Focusable="False"
                            HorizontalScrollBarVisibility="{Binding (ScrollViewer.HorizontalScrollBarVisibility), RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                            VerticalScrollBarVisibility="{Binding (ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!--  Left spacer = corner radius, keeps content clear of rounded corner  -->
                                            <ColumnDefinition Width="{DynamicResource datagrid_corner_filler_size}" />
                                            <!--  Content area  -->
                                            <ColumnDefinition Width="*" />
                                            <!--  Vertical scrollbar  -->
                                            <ColumnDefinition Width="Auto" />
                                            <!--  Right spacer = corner radius  -->
                                            <ColumnDefinition Width="{DynamicResource datagrid_corner_filler_size}" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <!--  Top spacer = corner radius  -->
                                            <RowDefinition Height="{DynamicResource datagrid_corner_filler_size}" />
                                            <!--  Column headers  -->
                                            <RowDefinition Height="Auto" />
                                            <!--  Data rows  -->
                                            <RowDefinition Height="*" />
                                            <!--  Horizontal scrollbar  -->
                                            <RowDefinition Height="Auto" />
                                            <!--  Bottom spacer = corner radius  -->
                                            <RowDefinition Height="{DynamicResource datagrid_corner_filler_size}" />
                                        </Grid.RowDefinitions>

                                        <!--  Select All button – fully collapsed  -->
                                        <Button
                                            Width="0"
                                            Command="{x:Static DataGrid.SelectAllCommand}"
                                            Focusable="False"
                                            Visibility="Collapsed" />

                                        <!--  Column headers — Col 1, Row 1  -->
                                        <DataGridColumnHeadersPresenter
                                            x:Name="PART_ColumnHeadersPresenter"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource CustomDefaultDataGridColumnHeadersPresenterStyle}"
                                            Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />

                                        <!--  Data rows — Col 1, Row 2  -->
                                        <ScrollContentPresenter
                                            x:Name="PART_ScrollContentPresenter"
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            CanContentScroll="{TemplateBinding CanContentScroll}" />

                                        <!--  Vertical scrollbar — Col 2, Rows 1-2  -->
                                        <ScrollBar
                                            x:Name="PART_VerticalScrollBar"
                                            Grid.Row="1"
                                            Grid.RowSpan="2"
                                            Grid.Column="2"
                                            Maximum="{TemplateBinding ScrollableHeight}"
                                            Orientation="Vertical"
                                            Style="{DynamicResource CustomScrollBar}"
                                            ViewportSize="{TemplateBinding ViewportHeight}"
                                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                            Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />

                                        <!--  Horizontal scrollbar — Col 1, Row 3  -->
                                        <ScrollBar
                                            x:Name="PART_HorizontalScrollBar"
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Maximum="{TemplateBinding ScrollableWidth}"
                                            Orientation="Horizontal"
                                            Style="{DynamicResource CustomScrollBar}"
                                            ViewportSize="{TemplateBinding ViewportWidth}"
                                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                            Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsGrouping" Value="True">
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
