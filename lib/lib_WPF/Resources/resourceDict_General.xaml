        <!--  Added style triggers so that it can be changed outside of control template.  -->
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="BorderThickness" Value="2,2,2,0" />
                <Setter Property="Border.CornerRadius" Value="12,12,0,0" />
