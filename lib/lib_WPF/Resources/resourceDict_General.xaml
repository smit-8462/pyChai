    <!--  Trigger label change based on ParameterType  -->
    <Style
        x:Key="ParameterTypeTag"
        BasedOn="{StaticResource CustomLabel_CardTag}"
        TargetType="Label">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ParameterType}" Value="Shared">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Background" Value="{DynamicResource theme_label_cardtag_bg01}" />
                <Setter Property="BorderBrush" Value="{DynamicResource theme_label_cardtag_fg01}" />
                <Setter Property="Foreground" Value="{DynamicResource theme_label_cardtag_fg01}" />
                <Setter Property="Content" Value="Shared" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ParameterType}" Value="Project">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Background" Value="{DynamicResource theme_label_cardtag_bg02}" />
                <Setter Property="BorderBrush" Value="{DynamicResource theme_label_cardtag_fg02}" />
                <Setter Property="Foreground" Value="{DynamicResource theme_label_cardtag_fg02}" />
                <Setter Property="Content" Value="Project" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ParameterType}" Value="Built-In">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Background" Value="{DynamicResource theme_label_cardtag_bg03}" />
                <Setter Property="BorderBrush" Value="{DynamicResource theme_label_cardtag_fg03}" />
                <Setter Property="Foreground" Value="{DynamicResource theme_label_cardtag_fg03}" />
                <Setter Property="Content" Value="Built-in" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Duplicate selection checker  -->
    <!--  Correct  -->
    <Style x:Key="CorrectIconStyle" TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Content">
            <Setter.Value>
                <ContentControl
                    Width="24"
                    Height="24"
                    Foreground="{DynamicResource theme_label_cardtag_fg02}"
                    Style="{DynamicResource IconControlStyle}"
                    Tag="{DynamicResource icon_correct}" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Warning  -->
    <Style x:Key="ErrorIconStyle" TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="ToolTip" Value="{Binding ErrorMessages}" />
        <Setter Property="Content">
            <Setter.Value>
                <ContentControl
                    Width="24"
                    Height="24"
                    Foreground="{DynamicResource theme_label_cardtag_fg03}"
                    Style="{DynamicResource IconControlStyle}"
                    Tag="{DynamicResource icon_warning_info}" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="ToolTip" Value="{Binding ErrorMessages}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!--#endregion-->

    <!--#region RICH TEXT BOX-->
    <Style x:Key="CustomRichTextBox_SingleLiner" TargetType="RichTextBox">
        <Setter Property="Foreground" Value="{DynamicResource theme_richtextbox_fg}" />
        <Setter Property="CaretBrush" Value="{DynamicResource theme_richtextbox_caretbrush}" />
        <Setter Property="Background" Value="{DynamicResource theme_richtextbox_bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource theme_button_border}" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="BorderThickness" Value="{StaticResource thickness_border_00}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RichTextBox}">
                    <Grid>
                        <!--  Layout-affecting border - size/padding never change  -->
                        <Border
                            x:Name="MainBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource corner_radius_02}"
                            Focusable="False">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="0,6"
                                Focusable="False"
                                Style="{StaticResource CustomScrollViewer}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="MainBorder" Property="Padding" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="{x:Type Paragraph}">
                <Setter Property="FontFamily" Value="{StaticResource font_family_default}" />
                <Setter Property="FontSize" Value="{StaticResource text_height_normal}" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="LineHeight" Value="22" />
                <Setter Property="LineStackingStrategy" Value="MaxHeight" />
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="CustomRichTextBox_SingleLiner_ReadOnly" TargetType="RichTextBox">
        <Setter Property="Foreground" Value="{DynamicResource theme_richtextbox_fg}" />
        <Setter Property="CaretBrush" Value="{DynamicResource theme_richtextbox_caretbrush}" />
        <Setter Property="Background" Value="{DynamicResource theme_richtextbox_bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource theme_button_border}" />
        <Setter Property="BorderThickness" Value="{StaticResource thickness_border_00}" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RichTextBox}">
                    <Grid>
                        <Border
                            x:Name="MainBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource corner_radius_02}"
                            Focusable="False">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="0"
                                VerticalAlignment="Center"
                                Focusable="False" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="MainBorder" Property="Padding" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="{x:Type Paragraph}">
                <Setter Property="FontFamily" Value="{StaticResource font_family_default}" />
                <Setter Property="FontSize" Value="{StaticResource text_height_normal}" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="LineHeight" Value="22" />
                <Setter Property="LineStackingStrategy" Value="MaxHeight" />
            </Style>
        </Style.Resources>
    </Style>
    <!--#endregion-->

    <!--#region GRID SPLITTER-->
    <Style x:Key="GridSplitterStyle_Vertical" TargetType="{x:Type GridSplitter}">
        <Setter Property="Width" Value="16" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource theme_button_fg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Rectangle
                            x:Name="PART_Background"
                            Grid.Row="0"
                            Fill="Transparent" />
                        <ContentControl
                            Grid.Row="0"
                            Width="{TemplateBinding MinHeight}"
                            Height="{TemplateBinding Width}"
                            Style="{StaticResource IconControlStyle_GridSplitter}"
                            Tag="{StaticResource icon_grid_splitter}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Background" Property="Fill" Value="{DynamicResource theme_combobox_bg}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="PART_Background" Property="Fill" Value="{DynamicResource theme_combobox_bg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region EXPANDER-->
    <ControlTemplate x:Key="ExpanderToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
        <Grid Margin="{TemplateBinding Padding}" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentPresenter
                x:Name="ContentPresenter"
                Grid.Column="1"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                TextElement.FontSize="{TemplateBinding FontSize}" />
            <Border
                x:Name="ExpanderIconBorder"
                Grid.Column="0"
                Width="18"
                Height="18"
                Margin="4,0,8,0"
                Padding="2"
                Background="{DynamicResource theme_toggleButton_disabled_bg}"
                BorderBrush="{DynamicResource theme_button_border}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid
                    x:Name="ChevronGrid"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Grid.RenderTransform>
                    <ContentControl
                        x:Name="ControlChevronIcon"
                        Width="8"
                        Height="8"
                        Style="{StaticResource IconControlStyle}"
                        Tag="{StaticResource icon_arrow_up}" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ExpanderIconBorder" Property="Background" Value="{DynamicResource theme_toggleButton_selected_fg}" />
                <Setter TargetName="ChevronGrid" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="180" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ExpanderIconBorder" Property="Background" Value="{DynamicResource theme_toggleButton_selected_fg}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="CustomExpander_NoScroll" TargetType="{x:Type Expander}">
        <Setter Property="Background" Value="{DynamicResource theme_richtextbox_bg}" />
        <Setter Property="Foreground" Value="{DynamicResource theme_richtextbox_fg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource theme_button_border}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsExpanded" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  Header - always visible  -->
                        <Border
                            x:Name="ToggleButtonBorder"
                            Grid.Row="0"
                            Padding="4"
                            Background="{DynamicResource theme_bg_02}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ToggleButton
                                x:Name="ExpanderToggleButton"
                                Margin="0"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding Header}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                IsEnabled="{TemplateBinding IsEnabled}"
                                OverridesDefaultStyle="True"
                                Template="{StaticResource ExpanderToggleButtonTemplate}" />
                        </Border>
                        <!--  Content - No ScrollViewer, sizes to content, no scrolling  -->
                        <Border
                            x:Name="ContentPresenterBorder"
                            Grid.Row="1"
                            Padding="0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,8,8"
                            Visibility="Collapsed">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ToggleButtonBorder" Property="BorderThickness" Value="6,1,1,0" />
                            <Setter TargetName="ToggleButtonBorder" Property="CornerRadius" Value="8,8,0,0" />
                            <Setter TargetName="ToggleButtonBorder" Property="Padding" Value="4" />
                            <Setter TargetName="ToggleButtonBorder" Property="Background" Value="{DynamicResource theme_error_card_bg}" />
                            <Setter TargetName="ContentPresenterBorder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentPresenterBorder" Property="BorderThickness" Value="6,0,1,1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ExpanderToggleButton" Property="Foreground" Value="{DynamicResource theme_button_border}" />
                        </Trigger>
                        <Trigger SourceName="ExpanderToggleButton" Property="IsMouseOver" Value="True">
                            <Setter TargetName="ExpanderToggleButton" Property="BorderBrush" Value="{DynamicResource theme_button_border}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region GRID VIEW-->
    <!--  Style - GridViewColumnHeader gripper (resize thumb)  -->
    <Style x:Key="CustomGridViewColumnHeaderGripperStyle" TargetType="{x:Type Thumb}">
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ******************  -->
    <!--  Style - GridViewColumnHeader (maps to DataGridColumnHeader style)  -->
    <Style x:Key="CustomDefaultGridViewColumnHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource theme_datagrid_header_bg}" />
        <Setter Property="Foreground" Value="{DynamicResource theme_datagrid_overall_fg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource theme_datagrid_gridline}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                    <Grid>
                        <Border
                            x:Name="HeaderBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Focusable="False"
                            IsHitTestVisible="False">
                            <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    Grid.Column="0"
                                    RecognizesAccessKey="True"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <!--  Sort icon placeholder  -->
                                <Path
                                    x:Name="SortArrow"
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Data="M 0,4 L 4,0 L 8,4 Z"
                                    Fill="{TemplateBinding Foreground}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Visibility="Collapsed">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <Thumb
                            x:Name="PART_HeaderGripper"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CustomGridViewColumnHeaderGripperStyle}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ******************  -->
    <!--  Style - ListViewItem (maps to DataGridRow style, incl. alternating rows)  -->
    <!--  NOTE: set ListView AlternationCount="2" for alternating rows to work  -->
    <Style x:Key="CustomDefaultListViewItemStyle" TargetType="{x:Type ListViewItem}">
        <Setter Property="Background" Value="{DynamicResource theme_datagrid_overall_bg}" />
        <Setter Property="Foreground" Value="{DynamicResource theme_datagrid_overall_fg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource theme_datagrid_overall_fg}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Height" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border
                        x:Name="LVI_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <GridViewRowPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Normal rows  -->
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter TargetName="LVI_Border" Property="Background" Value="{DynamicResource theme_datagrid_overall_bg}" />
                        </Trigger>
                        <!--  Alternating rows  -->
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter TargetName="LVI_Border" Property="Background" Value="{DynamicResource theme_datagrid_alternate_row_bg}" />
                        </Trigger>
                        <!--  Warning rows - overrides alternation coloring, must come after both above triggers  -->
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter TargetName="LVI_Border" Property="Background" Value="{DynamicResource theme_datagrid_invalid_row_bg}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ******************  -->
    <!--  Main style: ListView (GridView host, mirrors CustomDataGrid-03)  -->
    <Style x:Key="CustomListView-03" TargetType="{x:Type ListView}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource theme_datagrid_overall_fg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource theme_datagrid_gridline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource text_height_normal}" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource CustomDefaultListViewItemStyle}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListView}">
                    <Border
                        x:Name="border"
                        Padding="0"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True"
                        CornerRadius="0"
                        SnapsToDevicePixels="True">
                        <ScrollViewer
                            Padding="{TemplateBinding Padding}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <GridViewHeaderRowPresenter
                                    AllowsColumnReorder="False"
                                    ColumnHeaderContainerStyle="{StaticResource CustomDefaultGridViewColumnHeaderStyle}"
                                    ColumnHeaderTemplate="{Binding View.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderTemplateSelector="{Binding View.ColumnHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                    Columns="{Binding View.Columns, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ItemsPresenter />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region TOGGLE BUTTON-->
    <Style x:Key="CustomToggleButton_Transparent" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource theme_button_fg}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="ToggleBorder"
                        Margin="{TemplateBinding Margin}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region FLYOUT-->
    <Style x:Key="CustomFlyout_Popup" TargetType="Popup">
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="PopupAnimation" Value="Fade" />
        <Setter Property="StaysOpen" Value="False" />
        <Setter Property="VerticalOffset" Value="4" />
    </Style>

    <Style x:Key="CustomFlyout_Border" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource theme_bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource theme_border_brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource corner_radius_02}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="12"
                    Direction="270"
                    Opacity="0.25"
                    ShadowDepth="2" />
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->
</ResourceDictionary>
