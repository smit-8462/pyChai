    <!--#region BUTTONS-->
    <!--  Custom Button 01  -->
    <Style x:Key="CustomButton_01" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource theme_button_bg}" />
        <Setter Property="Foreground" Value="{DynamicResource theme_button_fg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource theme_button_border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource thickness_border_00}" />
        <Setter Property="Padding" Value="{DynamicResource padding_01}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource font_family_default}" />
        <Setter Property="FontSize" Value="{DynamicResource text_height_normal}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="button_border"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource corner_radius_02}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="button_border" Property="Background" Value="{DynamicResource theme_button_hover}" />
                            <Setter TargetName="button_border" Property="BorderThickness" Value="{DynamicResource thickness_border_01}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="button_border" Property="Background" Value="{DynamicResource theme_button_hover}" />
                            <Setter TargetName="button_border" Property="BorderThickness" Value="{DynamicResource thickness_border_01}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!--  Overriding default styles  -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Padding" Value="0" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Padding" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="CustomButton_02"
        BasedOn="{StaticResource CustomButton_01}"
        TargetType="Button">
        <Setter Property="Padding" Value="20,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Padding" Value="19,0" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Padding" Value="19,0" />
            </Trigger>
        </Style.Triggers>
    </Style>

