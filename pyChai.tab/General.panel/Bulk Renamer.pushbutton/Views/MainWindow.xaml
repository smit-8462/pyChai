                        </StackPanel>

                        <!--  Information  -->
                        <StackPanel Grid.Row="1" Margin="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup2" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,26"
                                    Style="{DynamicResource CustomTextBlock_SelectionLabelText}"
                                    Text="Count :" />
                                <Border
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    ClipToBounds="True"
                                    Style="{DynamicResource CustomBorder_02}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="26" />
                                            <RowDefinition Height="26" />
                                        </Grid.RowDefinitions>

                                        <!--  Grid Borders  -->
                                        <Border
                                            Grid.Row="0"
                                            Grid.ColumnSpan="3"
                                            Background="{DynamicResource theme_datagrid_header_bg}"
                                            BorderBrush="{DynamicResource theme_button_border}"
                                            BorderThickness="0,0,0,2"
                                            CornerRadius="7,7,0,0" />
                                        <Border
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="1"
                                            BorderBrush="{DynamicResource theme_button_border}"
                                            BorderThickness="1,0,1,0" />

                                        <!--  Headers  -->
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Style="{DynamicResource CustomTextBlock_TableHeader}"
                                            Text="Total" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Style="{DynamicResource CustomTextBlock_TableHeader}"
                                            Text="Success" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Style="{DynamicResource CustomTextBlock_TableHeader}"
                                            Text="Failed" />

                                        <!--  Content  -->
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            FontWeight="Normal"
                                            Style="{DynamicResource CustomTextBlock_TableHeader}"
                                            Text="{Binding InformationVM.CountTotal}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            FontWeight="Normal"
                                            Style="{DynamicResource CustomTextBlock_TableHeader}"
                                            Text="{Binding InformationVM.CountSuccess}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            FontWeight="Normal"
                                            Style="{DynamicResource CustomTextBlock_TableHeader}"
                                            Text="{Binding InformationVM.CountFailed}" />
                                    </Grid>
                                </Border>
                                <Button
                                    Grid.Column="2"
                                    Height="30"
                                    VerticalAlignment="Top"
                                    Click="ButtonEvent_Information_ShowError"
                                    Style="{DynamicResource CustomButton_01}"
                                    ToolTip="Click to see error report"
                                    Visibility="{Binding InformationVM.IsFinalApplyButtonClicked, Converter={StaticResource BoolToVisConverter}}">
                                    <ContentControl
                                        Width="14"
                                        Height="14"
                                        Style="{DynamicResource IconControlStyle}"
                                        Tag="{DynamicResource icon_error}" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!--  Rich Text box  -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup1" />
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup2" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" SharedSizeGroup="RowGroup1" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{DynamicResource CustomTextBlock_SelectionLabelText}"
                                Text="Rename : " />
                            <DockPanel
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1">
                                <RichTextBox
                                    x:Name="rtb_transform_text"
                                    Height="30"
                                    Margin="0,8,0,0"
                                    Padding="0"
                                    DockPanel.Dock="Bottom"
                                    GotFocus="RichTextBoxEvent_TransformBox_GotFocus"
                                    LostFocus="RichTextBoxEvent_TransformBox_LostFocus"
                                    Style="{DynamicResource CustomRichTextBox_SingleLiner_ReadOnly}"
                                    ToolTip="Parameter text transform"
                                    VerticalScrollBarVisibility="Disabled" />
                                <RichTextBox
                                    x:Name="tbx_rename_box"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    AcceptsReturn="False"
                                    GotFocus="RichTextBoxEvent_RenameBox_GotFocus"
                                    LostFocus="RichTextBoxEvent_LostFocus"
                                    PreviewMouseUp="RichTextBoxEvent_RenameBox_PreviewMouseUp"
                                    Style="{DynamicResource CustomRichTextBox_SingleLiner}"
                                    ToolTip="Create name" />
                            </DockPanel>
                            <GridSplitter
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="2"
                                Width="8"
                                Margin="0,8"
                                Style="{DynamicResource GridSplitterStyle_Vertical}" />
                            <ItemsControl
                                x:Name="itemsControl_dynamicParameters"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="3"
                                Margin="0,0,8,0"
                                ItemsSource="{Binding InformationVM.DynamicParameters}"
                                Style="{DynamicResource CustomItemsControl_Scrollable}">
                                <!--  Layout items in a horizontal WrapPanel  -->
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <!--  Visual appearance of each item in the ItemsControl  -->
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="ButtonEvent_Parameter_InsertText"
                                            Content="{Binding}"
                                            Style="{DynamicResource CustomButton05}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel
                                Grid.RowSpan="2"
                                Grid.Column="4"
                                VerticalAlignment="Top"
                                Orientation="Vertical">
                                <Button
                                    x:Name="btn_info_update"
                                    Height="30"
                                    Margin="0,0,0,8"
                                    Padding="0"
                                    Click="ButtonEvent_Information_Update"
                                    Content="Update"
                                    IsEnabled="{Binding InformationVM.IsToggleButtonOnHold}"
                                    Style="{DynamicResource CustomButton_01}"
                                    ToolTip="Update"
                                    Visibility="{Binding InformationVM.IsToggleButtonOnHold, Converter={StaticResource BoolToVisConverter}}" />
                                <Button
                                    x:Name="btn_info_apply"
                                    Height="30"
                                    Margin="0,0,0,8"
                                    Click="ButtonEvent_Information_TextBoxApply"
                                    Content="Apply"
                                    IsEnabled="{Binding InformationVM.IsToggleButtonOnHoldInvert}"
                                    Style="{DynamicResource CustomButton_01}"
                                    ToolTip="Apply Template name"
                                    Visibility="{Binding InformationVM.IsToggleButtonOnHoldInvert, Converter={StaticResource BoolToVisConverter}}" />
                                <Button
                                    x:Name="btn_info_clear"
                                    Height="30"
                                    Margin="0,0,0,8"
                                    Click="ButtonEvent_Information_TextBoxClear"
                                    Content="Clear"
                                    Style="{DynamicResource CustomButton_01}"
                                    ToolTip="Clear Template name" />
                                <Button
                                    x:Name="btn_info_cancel"
                                    Height="30"
                                    Margin="0,0,0,8"
                                    Click="ButtonEvent_Information_UpdateCancel"
                                    Content="Cancel"
                                    IsEnabled="{Binding InformationVM.IsToggleButtonOnHold}"
                                    ToolTip="Cancel Template name">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource CustomButton_01}" TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button
                                    Height="30"
                                    Click="ButtonEvent_Information_TextTransformClear"
                                    Style="{DynamicResource CustomButton_01}"
                                    ToolTip="Cancel Text Transform">
                                    <ContentControl
                                        Width="14"
                                        Height="14"
                                        Style="{StaticResource IconControlStyle}"
                                        Tag="{StaticResource icon_clear}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup1" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" MinWidth="200" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup2" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{DynamicResource CustomTextBlock_SelectionLabelText}"
                                Text="Transform: " />
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton
                                    x:Name="Choice_Text_Title"
                                    Grid.Column="0"
                                    Height="30"
                                    Command="{Binding InformationVM.Command_TextCaseType}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                    Content="Title"
                                    GroupName="RenameTextTransform"
                                    IsChecked="{Binding InformationVM.TextCase, Converter={StaticResource StringEqualsConverter}, ConverterParameter=title, Mode=OneWay}"
                                    ToolTip="Title case">
                                    <RadioButton.Style>
                                        <Style BasedOn="{StaticResource CustomRadioButton_Selecter}" TargetType="RadioButton">
                                            <Setter Property="Border.CornerRadius" Value="8,0,0,8" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Border.CornerRadius" Value="8,0,0,8" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                                <RadioButton
                                    x:Name="Choice_Text_Upper"
                                    Grid.Column="1"
                                    Height="30"
                                    Command="{Binding InformationVM.Command_TextCaseType}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                    Content="UPPER"
                                    GroupName="RenameTextTransform"
                                    IsChecked="{Binding InformationVM.TextCase, Converter={StaticResource StringEqualsConverter}, ConverterParameter=upper, Mode=OneWay}"
                                    ToolTip="Upper case">
                                    <RadioButton.Style>
                                        <Style BasedOn="{StaticResource CustomRadioButton_Selecter}" TargetType="RadioButton">
                                            <Setter Property="Border.CornerRadius" Value="0" />
                                            <Setter Property="BorderThickness" Value="0,1" />
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="BorderThickness" Value="1,2" />
                                                    <Setter Property="Border.CornerRadius" Value="0" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                                <RadioButton
                                    x:Name="Choice_Text_Lower"
                                    Grid.Column="2"
                                    Command="{Binding InformationVM.Command_TextCaseType}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                    Content="lower"
                                    GroupName="RenameTextTransform"
                                    IsChecked="{Binding InformationVM.TextCase, Converter={StaticResource StringEqualsConverter}, ConverterParameter=lower, Mode=OneWay}"
                                    ToolTip="Lower case">
                                    <RadioButton.Style>
                                        <Style BasedOn="{StaticResource CustomRadioButton_Selecter}" TargetType="RadioButton">
                                            <Setter Property="Border.CornerRadius" Value="0,8,8,0" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Border.CornerRadius" Value="0,8,8,0" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                            </Grid>

                            <!--  Embedding UserControl in this, so that we can use data-binding (don't want to deal with dependency property)  -->
                            <!--#region UserControl-->
                            <Border
                                x:Name="numberBoxUC"
                                Grid.Column="2"
                                Margin="8,0"
                                BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle
                                        Grid.Column="1"
                                        Grid.ColumnSpan="4"
                                        Fill="{DynamicResource theme_bg_02}"
                                        Stroke="{DynamicResource theme_button_border}"
                                        StrokeThickness="1" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Padding="6,0"
                                        Style="{DynamicResource CustomTextBlock_Button02}"
                                        Text="Retain " />
                                    <RadioButton
                                        x:Name="Choice_Slice_Left"
                                        Grid.Column="0"
                                        Command="{Binding InformationVM.Command_TextSlicingSide}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                        Content="L"
                                        GroupName="TextSide"
                                        IsChecked="{Binding InformationVM.SlicingSide, Converter={StaticResource StringEqualsConverter}, ConverterParameter=left, Mode=OneWay}"
                                        ToolTip="Retain Left side text">
                                        <RadioButton.Style>
                                            <Style BasedOn="{StaticResource CustomRadioButton_Selecter}" TargetType="RadioButton">
                                                <Setter Property="Border.CornerRadius" Value="8,0,0,8" />
                                                <Setter Property="BorderThickness" Value="1,1,0,1" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Setter Property="Border.CornerRadius" Value="8,0,0,8" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                    <RadioButton
                                        x:Name="Choice_Slice_Right"
                                        Grid.Column="1"
                                        Command="{Binding InformationVM.Command_TextSlicingSide}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                        Content="R"
                                        GroupName="TextSide"
                                        IsChecked="{Binding InformationVM.SlicingSide, Converter={StaticResource StringEqualsConverter}, ConverterParameter=right, Mode=OneWay}"
                                        ToolTip="Retain Right side text">
                                        <RadioButton.Style>
                                            <Style BasedOn="{StaticResource CustomRadioButton_Selecter}" TargetType="RadioButton">
                                                <Setter Property="Border.CornerRadius" Value="0,8,8,0" />
                                                <Setter Property="BorderThickness" Value="0,1,1,1" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Setter Property="Border.CornerRadius" Value="0,8,8,0" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                    <Rectangle
                                        Grid.Column="3"
                                        Margin="0,1,4,1"
                                        Panel.ZIndex="1"
                                        Fill="{DynamicResource theme_combobox_bg}"
                                        RadiusX="4"
                                        RadiusY="4"
                                        StrokeThickness="1" />
                                    <TextBox
                                        Grid.Column="3"
                                        Margin="0,0,4,0"
                                        Padding="2,0"
                                        Panel.ZIndex="2"
                                        BorderThickness="1"
                                        IsReadOnly="True"
                                        Style="{DynamicResource CustomTextBox_Search}"
                                        Text="{Binding InformationVM.SlicingValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Number of text to be retain" />
                                    <Button
                                        Grid.Column="4"
                                        Click="ButtonEvent_Number_Increment"
                                        Style="{DynamicResource CustomButton_04_PillLeft}"
                                        ToolTip="Increase">
                                        <ContentControl
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource IconControlStyle}"
                                            Tag="{StaticResource icon_arrow_up}" />
                                    </Button>
                                    <Button
                                        Grid.Column="5"
                                        Click="ButtonEvent_Number_Decrement"
                                        Style="{DynamicResource CustomButton_04_PillRight}"
                                        ToolTip="Decrease">
                                        <ContentControl
                                            Width="14"
                                            Height="14"
                                            Style="{StaticResource IconControlStyle}"
                                            Tag="{StaticResource icon_arrow_down}" />
                                    </Button>
                                </Grid>
                            </Border>
                            <!--#endregion-->

                            <Button
                                Grid.Row="0"
                                Grid.Column="4"
                                Click="ButtonEvent_Information_TextTransformApply"
                                Style="{DynamicResource CustomButton_01}"
                                ToolTip="Apply Text Transform">
                                <ContentControl
                                    Width="14"
                                    Height="14"
                                    Style="{StaticResource IconControlStyle}"
                                    Tag="{StaticResource icon_correct}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                <!--#endregion-->

                <!--  =============================================  -->
                <!--#region PRECHECK RENAMER-->
                <Border
                    Grid.Row="1"
                    Margin="0,12,16,12"
                    Style="{DynamicResource CustomBorder_01}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>

                        <!--  ListView  -->
                        <ScrollViewer
                            x:Name="list_scrollview"
                            Grid.Row="0"
                            Margin="12"
                            Background="FloralWhite"
                            Style="{DynamicResource CustomScrollViewer}">
                            <!--
                                DataContext inside each ListView/Expander item is now the "GroupData_Renamer" instance itself
                                (because ItemsControl.ItemTemplate sets that as the item's context), so "{Binding TemplateName}"" and
                                "{Binding DataGridCollection}" resolve directly off it - no need to re-path through RenamerListVM.
                            -->
                            <ItemsControl ItemsSource="{Binding RenamerListVM.GroupedTemplates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander x:Name="expander_list_preview" Style="{DynamicResource CustomExpander_NoScroll}">
                                            <Expander.Header>
                                                <StackPanel
                                                    MinHeight="26"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <ToggleButton Click="ButtonEvent_ExpanderHeader_LoadTemplate" ToolTip="Click to update template name">
                                                        <ToggleButton.IsChecked>
                                                            <MultiBinding Converter="{StaticResource ObjectReferenceEqualsConverter}" Mode="OneWay">
                                                                <Binding Path="DataContext.InformationVM.EditingTemplate" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                <Binding Path="." />
                                                            </MultiBinding>
                                                        </ToggleButton.IsChecked>
                                                        <ContentControl Content="{Binding TemplateName}" ContentTemplate="{StaticResource TokenizedHeaderTemplate}" />
                                                        <ToggleButton.Style>
                                                            <Style BasedOn="{StaticResource CustomToggleButton_Transparent}" TargetType="ToggleButton">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter Property="Opacity" Value="0.5" />
                                                                        <Setter Property="IsHitTestVisible" Value="False" />
                                                                        <Setter Property="IsTabStop" Value="False" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsChecked" Value="False">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                        <Setter Property="IsHitTestVisible" Value="True" />
                                                                        <Setter Property="IsTabStop" Value="True" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource theme_scrollbar_thumb_hover}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <Rectangle
                                                        Width="4"
                                                        Margin="6,4"
                                                        VerticalAlignment="Stretch"
                                                        Fill="{DynamicResource theme_color_101}" />
                                                    <Label Style="{DynamicResource TokenTag_02}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Total : " />
                                                            <TextBlock Text="{Binding CountTotal}" />
                                                        </StackPanel>
                                                    </Label>
                                                    <Rectangle
                                                        Width="4"
                                                        Margin="6,4"
                                                        VerticalAlignment="Stretch"
                                                        Fill="{DynamicResource theme_color_101}" />
                                                    <Button
                                                        Margin="0,2"
                                                        Click="ButtonEvent_ListItem_ShowError"
                                                        Height="22"
                                                        Style="{DynamicResource CustomButton_03_Error}"
                                                        ToolTip="Check error">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Error : " />
                                                            <TextBlock Text="{Binding CountError}" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Expander.Header>

                                            <ListView
                                                x:Name="listview_preview"
                                                Margin="8"
                                                ItemsSource="{Binding DataGridCollection}"
                                                PreviewMouseWheel="ListViewEvent_PreviewMouseWheel"
                                                Style="{DynamicResource CustomListView-03}">
                                                <ListView.View>
                                                    <GridView AllowsColumnReorder="False">
                                                        <GridViewColumn
                                                            Width="50"
                                                            DisplayMemberBinding="{Binding SerialNumber}"
                                                            Header="S. No." />
                                                        <GridViewColumn
                                                            Width="250"
                                                            DisplayMemberBinding="{Binding OldName}"
                                                            Header="Current Type Name" />
                                                        <GridViewColumn Width="60" Header="Symbol">
                                                            <GridViewColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <ToggleButton
                                                                            x:Name="NameValidationChecker"
                                                                            HorizontalAlignment="Center"
                                                                            IsEnabled="{Binding HasError}">
                                                                            <ContentControl Width="14" Height="14">
                                                                                <ContentControl.Style>
                                                                                    <Style BasedOn="{StaticResource IconControlStyle}" TargetType="ContentControl">
                                                                                        <Setter Property="Tag" Value="{StaticResource icon_correct}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                                                <Setter Property="Tag" Value="{StaticResource icon_warning_info}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </ContentControl.Style>
                                                                            </ContentControl>
                                                                            <ToggleButton.Style>
                                                                                <Style BasedOn="{StaticResource CustomToggleButton_Transparent}" TargetType="ToggleButton">
                                                                                    <Style.Triggers>
                                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                                            <Setter Property="Opacity" Value="1" />
                                                                                        </Trigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ToggleButton.Style>
                                                                        </ToggleButton>
                                                                        <Popup
                                                                            IsOpen="{Binding IsChecked, ElementName=NameValidationChecker, Mode=TwoWay}"
                                                                            PlacementTarget="{Binding ElementName=NameValidationChecker}"
                                                                            Style="{StaticResource CustomFlyout_Popup}">
                                                                            <Border Style="{StaticResource CustomFlyout_Border}">
                                                                                <TextBlock Style="{DynamicResource CustomTextBlock_NormalText}" Text="{Binding ErrorMessage}" />
                                                                            </Border>
                                                                        </Popup>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </GridViewColumn.CellTemplate>
                                                        </GridViewColumn>
                                                        <GridViewColumn
                                                            Width="250"
                                                            DisplayMemberBinding="{Binding NewName}"
                                                            Header="Updated Type Name" />
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!--  Buttons  -->
                        <StackPanel
                            Grid.Row="1"
                            Height="30"
                            Margin="12,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <Button
                                Margin="4,0"
                                Click="ButtonEvent_ListPreview_Close"
                                Content="Close"
                                Style="{DynamicResource CustomButton_02}"
                                ToolTip="Close window" />
                            <Button
                                Margin="4,0"
                                Click="ButtonEvent_ListPreview_Reset"
                                Content="Reset"
                                Style="{DynamicResource CustomButton_02}"
                                ToolTip="Reset items in list" />
                            <Button
                                Margin="4,0"
                                Click="ButtonEvent_ListPreview_Apply"
                                Content="Apply"
                                IsEnabled="{Binding InformationVM.IsFinalApplyButtonEnabled}"
                                ToolTip="Apply rename">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource CustomButton_02}" TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <!--#endregion-->
            </Grid>
        </Grid>
    </Border>
</Window>
