<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="MainWindow"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    AllowsTransparency="True"
    Background="Transparent"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStyle="None"
    mc:Ignorable="d">
    <!--  Window Customize  -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CornerRadius="16"
            GlassFrameThickness="0"
            NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!--  Declare the built-in converter here  -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <Style x:Key="TokenTag" TargetType="Label">
            <Setter Property="Background" Value="#c9e6f5" />
            <Setter Property="Foreground" Value="{DynamicResource theme_label_cardtag_fg01}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{DynamicResource font_family_default}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,2,1,2" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <Border
                            Height="{TemplateBinding Height}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding Foreground}"
                            BorderThickness="{DynamicResource thickness_border_00}"
                            CornerRadius="{DynamicResource corner_radius_03}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="TokenTag_02"
            BasedOn="{StaticResource TokenTag}"
            TargetType="Label">
            <Setter Property="Background" Value="{DynamicResource theme_label_cardtag_bg03}" />
            <Setter Property="Foreground" Value="{DynamicResource theme_label_cardtag_fg03}" />
        </Style>

        <Style x:Key="TokenTagCombined" TargetType="Label">
            <Setter Property="Background" Value="#c9e6f5" />
            <Setter Property="Foreground" Value="{DynamicResource theme_label_cardtag_fg01}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{DynamicResource font_family_default}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,2,1,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <StackPanel
                            Height="{TemplateBinding Height}"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                            <!--  Left pill - Parameter name  -->
                            <Border
                                VerticalAlignment="Stretch"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding Foreground}"
                                BorderThickness="{DynamicResource thickness_border_00}"
                                CornerRadius="4,0,0,4">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=Name}" />
                            </Border>
                            <!--  Right pill - Text transform summary (Case : Side : Value)  -->
                            <Border
                                VerticalAlignment="Stretch"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource theme_label_cardtag_bg02}"
                                BorderBrush="{TemplateBinding Foreground}"
                                BorderThickness="0,1,1,1"
                                CornerRadius="0,4,4,0"
                                Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=HasTransform}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,4"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        x:Name="ChangeLabel_01"
                                        VerticalAlignment="Center"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Foreground="{DynamicResource theme_label_cardtag_fg02}"
                                        Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=Case}" />
                                    <TextBlock
                                        x:Name="ChangeLabel_02"
                                        VerticalAlignment="Center"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{DynamicResource theme_label_cardtag_fg02}"
                                        Text=" : "
                                        Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=HasSideAndValue}" />
                                    <TextBlock
                                        x:Name="ChangeLabel_03"
                                        VerticalAlignment="Center"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Foreground="{DynamicResource theme_label_cardtag_fg02}"
                                        Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=Side}"
                                        Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=HasSideAndValue}" />
                                    <TextBlock
                                        x:Name="ChangeLabel_04"
                                        VerticalAlignment="Center"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{DynamicResource theme_label_cardtag_fg02}"
                                        Text=" : "
                                        Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=HasSideAndValue}" />
                                    <TextBlock
                                        x:Name="ChangeLabel_05"
                                        VerticalAlignment="Center"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Foreground="{DynamicResource theme_label_cardtag_fg02}"
                                        Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=Value}"
                                        Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=HasSideAndValue}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Renders a string with |token| spans as inline chips, same as SingleChoiceWindow's row template.  -->
        <DataTemplate x:Key="TokenizedHeaderTemplate">
            <ItemsControl ItemsSource="{Binding Converter={StaticResource StringToSegmentsConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Text="{Binding Text}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToken}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!--  Token chip - simple, visible when IsToken=True and IsCombined=False  -->
                            <Label Content="{Binding Text}" VerticalAlignment="Center">
                                <Label.Style>
                                    <Style BasedOn="{StaticResource TokenTag}" TargetType="Label">
                                        <Setter Property="Visibility" Value="{Binding IsToken, Converter={StaticResource BoolToVisConverter}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCombined}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                            <!--  Token chip - combined, visible only when IsCombined=True  -->
                            <Label Content="{Binding Text}" VerticalAlignment="Center">
                                <Label.Style>
                                    <Style BasedOn="{StaticResource TokenTagCombined}" TargetType="Label">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCombined}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="TokenTemplate">
            <Label Content="{Binding}" Style="{StaticResource TokenTag}" />
        </DataTemplate>

        <DataTemplate x:Key="TokenTemplateCombined">
            <Label Content="{Binding}" Style="{StaticResource TokenTagCombined}" />
        </DataTemplate>
    </Window.Resources>

    <Border Style="{DynamicResource CustomBorder_Window}">
        <!--  For correctly render window border, we have made background transparent  -->
        <Grid x:Name="root_grid" Background="Transparent">
            <!--  =============================================  -->
            <!--#region BASIC WINDOW-->
            <!--  Creating rows & columns  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="450" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="600" />
            </Grid.ColumnDefinitions>

            <!--  We cannot use UserControl directly, so substitute it with FrameworkElement type (Grid, StackPanel, etc.)  -->
            <!--  Also, since we have removed the XAML namespace, therefore we are doing above thing.  -->
            <!--  Top Window Bar  -->
            <Grid
                x:Name="window_top_bar_uc"
                Grid.Row="0"
                Grid.ColumnSpan="3" />

            <Grid
                Grid.Row="0"
                Grid.Column="2"
                Width="120"
                Margin="0,8,180,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Panel.ZIndex="2"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <ComboBox
                    x:Name="PickChoiceComboBox"
                    SelectedValue="{Binding ComboPickChoice, Mode=TwoWay}"
                    SelectedValuePath="Tag"
                    SelectionChanged="ComboBoxEvent_ToolPick_SelectionChanged"
                    Style="{DynamicResource CustomComboBox}">
                    <ComboBoxItem
                        Content="Family Type"
                        IsSelected="True"
                        Tag="combo_pick_family_type" />
                    <ComboBoxItem Content="Views" Tag="combo_pick_view" />
                    <ComboBoxItem Content="Sheets" Tag="combo_pick_sheet" />
                    <ComboBoxItem Content="Levels" Tag="combo_pick_level" />
                </ComboBox>
            </Grid>

            <!--  Bottom Window Bar  -->
            <Grid
                x:Name="window_bottom_bar_uc"
                Grid.Row="2"
                Grid.ColumnSpan="3" />
            <!--#endregion-->

            <!--  =============================================  -->
            <!--#region TREEVIEWER-->
            <GridSplitter
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,24"
                Style="{DynamicResource GridSplitterStyle_Vertical}" />
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Margin="16,12,0,12"
                Style="{DynamicResource CustomBorder_01}">
                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <!--  Button size = 30px (including border brush) + 12px margin gap  -->
                        <RowDefinition Height="32" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <!--
                        Bind TextBlock directly to the ComboBox's SelectedItem.Content. Add {} right before the format string to
                        explicitly tell WPF that the braces are literal format specifiers rather than XAML markup extensions.
                    -->
                    <TextBlock
                        Grid.Row="0"
                        Margin="12,0"
                        VerticalAlignment="Bottom"
                        FontSize="16"
                        Style="{DynamicResource CustomTextBlock_SelectionLabelText}"
                        Text="{Binding ElementName=PickChoiceComboBox, Path=SelectedItem.Content, StringFormat={}{0} :}" />
                    <!--  Choice of selection  -->
                    <!--  Pick - Family Type  -->
                    <Grid
                        x:Name="Pick_FamilyType"
                        Grid.Row="1"
                        Margin="24,8,24,0"
                        Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="Choice_FamilyType_Builtin"
                            Grid.Column="0"
                            Command="{Binding TreeViewerVM.Command_SelectionType}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Content="Built-In"
                            GroupName="RenameSelectionType"
                            Style="{DynamicResource CustomRadioButton_Selecter}"
                            ToolTip="Default built-in Family" />
                        <RadioButton
                            x:Name="Choice_FamilyType_Loaded"
                            Grid.Column="1"
                            Margin="8,0"
                            Command="{Binding TreeViewerVM.Command_SelectionType}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Content="Loaded"
                            GroupName="RenameSelectionType"
                            Style="{DynamicResource CustomRadioButton_Selecter}"
                            ToolTip="User loaded Family" />
                        <RadioButton
                            x:Name="Choice_FamilyType_Both"
                            Grid.Column="2"
                            Margin="0"
                            Command="{Binding TreeViewerVM.Command_SelectionType}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Content="All"
                            GroupName="RenameSelectionType"
                            Style="{DynamicResource CustomRadioButton_Selecter}"
                            ToolTip="All Families" />
                    </Grid>
                    <!--  Pick - Levels  -->
                    <Grid
                        x:Name="Pick_Level"
                        Grid.Row="1"
                        Margin="24,8,24,0"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="Choice_Level_Active"
                            Grid.Column="0"
                            Command="{Binding TreeViewerVM.Command_SelectionType}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Content="Active"
                            GroupName="RenameSelectionType"
                            Style="{DynamicResource CustomRadioButton_Selecter}"
                            ToolTip="Level having active floor plan" />
                        <RadioButton
                            x:Name="Choice_Level_Stray"
                            Grid.Column="1"
                            Margin="8,0"
                            Command="{Binding TreeViewerVM.Command_SelectionType}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Content="Stray"
                            GroupName="RenameSelectionType"
                            Style="{DynamicResource CustomRadioButton_Selecter}"
                            ToolTip="Level not having attached floor plan" />
                        <RadioButton
                            x:Name="Choice_Level_Both"
                            Grid.Column="2"
                            Margin="0"
                            Command="{Binding TreeViewerVM.Command_SelectionType}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Content="All"
                            GroupName="RenameSelectionType"
                            Style="{DynamicResource CustomRadioButton_Selecter}"
                            ToolTip="All levels" />
                    </Grid>
                    <!--  Pick - Sheets  -->
                    <Grid
                        x:Name="Pick_Sheet"
                        Grid.Row="1"
                        Margin="24,8,24,0"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="Choice_Sheet_Empty"
                            Grid.Column="0"
                            Command="{Binding TreeViewerVM.Command_SelectionType}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Content="Empty"
                            GroupName="RenameSelectionType"
                            Style="{DynamicResource CustomRadioButton_Selecter}"
                            ToolTip="Empty sheets" />
                        <RadioButton
                            x:Name="Choice_Sheet_Filled"
                            Grid.Column="1"
                            Margin="8,0"
                            Command="{Binding TreeViewerVM.Command_SelectionType}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Content="Filled"
                            GroupName="RenameSelectionType"
                            Style="{DynamicResource CustomRadioButton_Selecter}"
                            ToolTip="Sheet filled with views" />
                        <RadioButton
                            x:Name="Choice_Sheet_Both"
                            Grid.Column="2"
                            Margin="0"
                            Command="{Binding TreeViewerVM.Command_SelectionType}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Content="All"
                            GroupName="RenameSelectionType"
                            Style="{DynamicResource CustomRadioButton_Selecter}"
                            ToolTip="All sheets" />
                    </Grid>
                    <!--  Pick - Views  -->
                    <Grid
                        x:Name="Pick_View"
                        Grid.Row="1"
                        Margin="24,8,24,0"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="Choice_View_OnSheet"
                            Grid.Column="0"
                            Command="{Binding TreeViewerVM.Command_SelectionType}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Content="On Sheet"
                            GroupName="RenameSelectionType"
                            Style="{DynamicResource CustomRadioButton_Selecter}"
                            ToolTip="Views placed on sheet" />
                        <RadioButton
                            x:Name="Choice_View_OffSheet"
                            Grid.Column="1"
                            Margin="8,0"
                            Command="{Binding TreeViewerVM.Command_SelectionType}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Content="Off Sheet"
                            GroupName="RenameSelectionType"
                            Style="{DynamicResource CustomRadioButton_Selecter}"
                            ToolTip="Views not placed on sheet" />
                        <RadioButton
                            x:Name="Choice_View_Both"
                            Grid.Column="2"
                            Margin="0"
                            Command="{Binding TreeViewerVM.Command_SelectionType}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Content="All"
                            GroupName="RenameSelectionType"
                            Style="{DynamicResource CustomRadioButton_Selecter}"
                            ToolTip="All sheets" />
                    </Grid>

                    <!--  Tree view selection  -->
                    <Border
                        Grid.Row="2"
                        Margin="12,0,12,12"
                        Style="{DynamicResource CustomBorder_12}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="12,12,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{DynamicResource CustomBorder_13}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            Click="ButtonEvent_TreeViewer_ExpandAllItems"
                                            Foreground="{DynamicResource theme_button_fg}"
                                            Style="{DynamicResource CustomButton_03_Transparent}"
                                            ToolTip="Expand all items">
                                            <ContentControl
                                                Width="18"
                                                Height="18"
                                                Style="{StaticResource IconControlStyle}"
                                                Tag="{StaticResource icon_expand_all}" />
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            Click="ButtonEvent_TreeViewer_CollapseAllItems"
                                            Foreground="{DynamicResource theme_button_fg}"
                                            Style="{DynamicResource CustomButton_03_Transparent}"
                                            ToolTip="Collapse all items">
                                            <ContentControl
                                                Width="18"
                                                Height="18"
                                                Style="{StaticResource IconControlStyle}"
                                                Tag="{StaticResource icon_collapse_all}" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Margin="8,0"
                                    Style="{DynamicResource CustomBorder_13}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="TreeView_Searchbox"
                                            Grid.Column="0"
                                            BorderThickness="0"
                                            Style="{DynamicResource CustomTextBox_Search}"
                                            Tag="Search..."
                                            TextChanged="TextBoxEvent_TreeView_Searchbox_TextChanged" />
                                        <Button
                                            Grid.Column="1"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            Click="ButtonEvent_TreeViewer_ClearSearch"
                                            Foreground="{DynamicResource theme_button_fg}"
                                            Style="{DynamicResource CustomButton_03_Transparent}"
                                            ToolTip="Clear search text">
                                            <ContentControl
                                                Width="18"
                                                Height="18"
                                                Style="{StaticResource IconControlStyle}"
                                                Tag="{StaticResource icon_close}" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{DynamicResource CustomBorder_13}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            Click="ButtonEvent_TreeViewer_SelectAll"
                                            Foreground="{DynamicResource theme_button_fg}"
                                            Style="{DynamicResource CustomButton_03_Transparent}"
                                            ToolTip="Select all items">
                                            <ContentControl
                                                Width="18"
                                                Height="18"
                                                Style="{StaticResource IconControlStyle}"
                                                Tag="{StaticResource icon_select_all_2}" />
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            Click="ButtonEvent_TreeViewer_ClearAll"
                                            Foreground="{DynamicResource theme_button_fg}"
                                            Style="{DynamicResource CustomButton_03_Transparent}"
                                            ToolTip="Clear all items">
                                            <ContentControl
                                                Width="18"
                                                Height="18"
                                                Style="{StaticResource IconControlStyle}"
                                                Tag="{StaticResource icon_select_none_2}" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            Click="ButtonEvent_TreeViewer_Invert"
                                            Foreground="{DynamicResource theme_button_fg}"
                                            Style="{DynamicResource CustomButton_03_Transparent}"
                                            ToolTip="Invert selection">
                                            <ContentControl
                                                Width="18"
                                                Height="18"
                                                Style="{StaticResource IconControlStyle}"
                                                Tag="{StaticResource icon_select_invert}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TreeView
                                x:Name="TreeView_Selecter"
                                Grid.Row="1"
                                Margin="12,4,12,12"
                                Padding="8"
                                ItemsSource="{Binding TreeViewerVM.RootItems}"
                                Style="{DynamicResource CustomTreeView_Default}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <Viewbox
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0">
                                                <Path Data="{Binding Converter={StaticResource HeaderToIconConverter}}" Style="{DynamicResource BaseIconStyle}" />
                                            </Viewbox>
                                            <TextBlock Style="{DynamicResource CustomTextBlock_NormalText}" Text="{Binding Header}" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>

                    <!--  Type selection options  -->
                    <StackPanel
                        Grid.Row="3"
                        Height="30"
                        Margin="12,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                        <Button
                            Margin="4,0"
                            Click="ButtonEvent_Information_TextBoxCancel"
                            Content="Cancel"
                            Style="{DynamicResource CustomButton_02}"
                            ToolTip="Cancel items selected in tree" />
                        <Button
                            Margin="4,0"
                            Click="ButtonEvent_TreeViewer_Refresh"
                            Content="Refresh"
                            Style="{DynamicResource CustomButton_02}"
                            ToolTip="Refresh items in tree" />
                        <Button
                            Margin="4,0"
                            Click="ButtonEvent_TreeViewer_Next"
                            Content="Next"
                            Style="{DynamicResource CustomButton_02}"
                            ToolTip="Use selected items in tree for rename" />
                    </StackPanel>
                </Grid>
            </Border>
            <!--#endregion-->

            <!--  =============================================  -->
            <Grid Grid.Row="1" Grid.Column="2">
                <!--  Creating rows & columns  -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  =============================================  -->
                <!--#region INFORMATION-->
                <Border
                    Grid.Row="0"
                    Margin="0,12,16,0"
                    Style="{DynamicResource CustomBorder_01}">
                    <Grid Margin="12" Grid.IsSharedSizeScope="True">
                        <!--  Creating rows & columns  -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" SharedSizeGroup="RowGroup1" />
                            <RowDefinition Height="72" />
                            <RowDefinition Height="144" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Configurations  -->
                        <StackPanel Grid.Row="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" SharedSizeGroup="ColumnGroup1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" SharedSizeGroup="ColumnGroup2" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{DynamicResource CustomTextBlock_SelectionLabelText}"
                                    Text="Template : " />
                                <Button
                                    Grid.Column="1"
                                    Margin="0,0,4,0"
                                    Click="ButtonEvent_Information_LoadTemplate"
                                    Style="{DynamicResource CustomButton_01}"
                                    ToolTip="Load Template from file">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <ContentControl
                                            Width="14"
                                            Height="14"
                                            Style="{DynamicResource IconControlStyle}"
                                            Tag="{DynamicResource icon_import}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{DynamicResource CustomTextBlock_Button02}"
                                            Text="Load" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="2"
                                    Margin="4,0,4,0"
                                    Click="ButtonEvent_Information_SaveTemplate"
                                    Style="{DynamicResource CustomButton_01}"
                                    ToolTip="Save Template to file">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <ContentControl
                                            Width="14"
                                            Height="14"
                                            Style="{DynamicResource IconControlStyle}"
                                            Tag="{DynamicResource icon_export}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{DynamicResource CustomTextBlock_Button02}"
                                            Text="Save" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="3"
                                    Margin="4,0,8,0"
                                    Click="ButtonEvent_Information_PickTemplate"
                                    IsEnabled="{Binding InformationVM.IsTemplateFileLoaded}"
                                    ToolTip="Pick Template from list">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <ContentControl
                                            Width="14"
                                            Height="14"
                                            Style="{DynamicResource IconControlStyle}"
                                            Tag="{DynamicResource icon_pick}" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{DynamicResource CustomTextBlock_Button02}"
                                            Text="Pick" />
                                    </StackPanel>
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource CustomButton_01}" TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button
                                    Grid.Column="4"
                                    Click="ButtonEvent_Information_TemplateReload"
                                    IsEnabled="{Binding InformationVM.IsTemplateFileLoaded}"
                                    ToolTip="Reload Template file">
                                    <ContentControl
                                        Width="14"
                                        Height="14"
                                        Style="{StaticResource IconControlStyle}"
                                        Tag="{StaticResource icon_refresh}" />
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource CustomButton_01}" TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </Trigger>
