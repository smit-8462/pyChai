<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="SingleChoiceWindow"
    Width="400"
    Height="450"
    MinWidth="400"
    MinHeight="450"
    AllowsTransparency="True"
    Background="Transparent"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStyle="None"
    mc:Ignorable="d">
    <!--  Window Customize  -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CornerRadius="16"
            GlassFrameThickness="0"
            NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!--  Declare the built-in converter here  -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <Style x:Key="TokenTag" TargetType="Label">
            <Setter Property="Background" Value="#c9e6f5" />
            <Setter Property="Foreground" Value="{DynamicResource theme_label_cardtag_fg01}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{DynamicResource font_family_default}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,2,1,2" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <Border
                            Height="{TemplateBinding Height}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding Foreground}"
                            BorderThickness="{DynamicResource thickness_border_00}"
                            CornerRadius="{DynamicResource corner_radius_03}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TokenTagCombined" TargetType="Label">
            <Setter Property="Background" Value="#c9e6f5" />
            <Setter Property="Foreground" Value="{DynamicResource theme_label_cardtag_fg01}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{DynamicResource font_family_default}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,2,1,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <StackPanel
                            Height="{TemplateBinding Height}"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                            <!--  Left pill - Parameter name  -->
                            <Border
                                VerticalAlignment="Stretch"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding Foreground}"
                                BorderThickness="{DynamicResource thickness_border_00}"
                                CornerRadius="4,0,0,4">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=Name}" />
                            </Border>
                            <!--  Right pill - Text transform summary (Case : Side : Value)  -->
                            <Border
                                VerticalAlignment="Stretch"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource theme_label_cardtag_bg02}"
                                BorderBrush="{TemplateBinding Foreground}"
                                BorderThickness="0,1,1,1"
                                CornerRadius="0,4,4,0"
                                Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=HasTransform}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    Margin="0,4"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        x:Name="ChangeLabel_01"
                                        VerticalAlignment="Center"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Foreground="{DynamicResource theme_label_cardtag_fg02}"
                                        Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=Case}" />
                                    <TextBlock
                                        x:Name="ChangeLabel_02"
                                        VerticalAlignment="Center"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{DynamicResource theme_label_cardtag_fg02}"
                                        Text=" : "
                                        Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=HasSideAndValue}" />
                                    <TextBlock
                                        x:Name="ChangeLabel_03"
                                        VerticalAlignment="Center"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Foreground="{DynamicResource theme_label_cardtag_fg02}"
                                        Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=Side}"
                                        Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=HasSideAndValue}" />
                                    <TextBlock
                                        x:Name="ChangeLabel_04"
                                        VerticalAlignment="Center"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{DynamicResource theme_label_cardtag_fg02}"
                                        Text=" : "
                                        Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=HasSideAndValue}" />
                                    <TextBlock
                                        x:Name="ChangeLabel_05"
                                        VerticalAlignment="Center"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Foreground="{DynamicResource theme_label_cardtag_fg02}"
                                        Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=Value}"
                                        Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource CombinedTokenPartConverter}, ConverterParameter=HasSideAndValue}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Row template -> splits each ListBox item's string into segments, then lays them out
            left-to-right so tokens render as inline chips - matching the RichTextBox look.
        -->
        <DataTemplate x:Key="TokenizedRowTemplate">
            <ItemsControl ItemsSource="{Binding Converter={StaticResource StringToSegmentsConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid VerticalAlignment="Center">
                            <!--  Plain text - visible by default, collapsed when IsToken is True  -->
                            <TextBlock VerticalAlignment="Center" Text="{Binding Text}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToken}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!--  Token chip - simple, visible when IsToken=True and IsCombined=False  -->
                            <Label Content="{Binding Text}" VerticalAlignment="Center">
                                <Label.Style>
                                    <Style BasedOn="{StaticResource TokenTag}" TargetType="Label">
                                        <Setter Property="Visibility" Value="{Binding IsToken, Converter={StaticResource BoolToVisConverter}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCombined}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                            <!--  Token chip - combined, visible only when IsCombined=True  -->
                            <Label Content="{Binding Text}" VerticalAlignment="Center">
                                <Label.Style>
                                    <Style BasedOn="{StaticResource TokenTagCombined}" TargetType="Label">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCombined}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>

    <Border Style="{DynamicResource CustomBorder_Window}">
        <!--  For correctly render window border, we have made background transparent  -->
        <Grid x:Name="root_grid" Background="Transparent">
            <!--  =============================================  -->
            <!--#region BASIC WINDOW-->
            <!--  Creating rows & columns  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  We cannot use UserControl directly, so substitute it with FrameworkElement type (Grid, StackPanel, etc.)  -->
            <!--  Also, since we have removed the XAML namespace, therefore we are doing above thing.  -->
            <!--  Top Window Bar  -->
            <Grid x:Name="window_top_bar_uc" Grid.Row="0" />
            <!--#endregion-->

            <!--#region User choice select-->
            <Border
                Grid.Row="1"
                Margin="16"
                Padding="12"
                Style="{DynamicResource CustomBorder_01}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Style="{DynamicResource CustomTextBlock_SelectionLabelText}"
                        Text="Pick Template : " />
                    <!--  Since we are attaching MainWindowViewModel.InformationVM directly in SingleChoiceWindow.py DataContext, therefore we can directly access property inside InformationVM.  -->
                    <ListBox
                        x:Name="listbox_templates"
                        Grid.Row="1"
                        Margin="0,8"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Top"
                        ItemTemplate="{StaticResource TokenizedRowTemplate}"
                        ItemsSource="{Binding TemplateCollection}"
                        ScrollViewer.CanContentScroll="False"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        SelectionMode="Single"
                        Style="{DynamicResource CustomItemsControl_Scrollable}" />
                    <StackPanel
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Orientation="Horizontal">
                        <Button
                            Margin="4,0"
                            Click="ButtonEvent_SelectWindow_Cancel"
                            Content="Cancel"
                            Style="{DynamicResource CustomButton_02}" />
                        <Button
                            Margin="4,0"
                            Click="ButtonEvent_SelectWindow_Select"
                            Content="Select"
                            IsEnabled="{Binding IsApplyButtonEnabled_SingleChoice}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CustomButton_02}" TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!--#endregion-->
        </Grid>
    </Border>
</Window>
