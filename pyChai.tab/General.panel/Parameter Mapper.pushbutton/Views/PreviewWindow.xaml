<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="WindowPreview"
    Width="800"
    Height="600"
    MinWidth="800"
    MinHeight="600"
    mc:Ignorable="d"
    Background="Transparent"
    AllowsTransparency="True"
    WindowStyle="None"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <Window.Resources>
        <!--  Built-in WPF converter - no custom class needed. Converts bool to Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Base style for validated DataGrid cells. -->
        <Style x:Key="ValidatedCellStyle"
               BasedOn="{StaticResource CustomDefaultDataGridCellStyle}"
               TargetType="{x:Type DataGridCell}">
            <!--  No additional static setters needed — the DataTrigger is added per-column in code-behind.  -->
        </Style>
    </Window.Resources>
    
    <!--  Window Customize  -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CornerRadius="12"
            GlassFrameThickness="0"
            NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Border Style="{DynamicResource CustomBorder_Window}">
        <!--  For correctly render window border, we have made background transparent  -->
        <Grid x:Name="preview_grid" Background="Transparent">
            <!--  Creating rows & columns  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <!--#region TOP WINDOW BAR-->
            <Grid
                x:Name="window_top_bar_uc"
                Grid.Row="0" />
            <!--#endregion-->
            <!--  ************************************  -->

            <!--#region BOTTOM WINDOW FOOTER-->
            <Grid
                x:Name="window_bottom_bar_uc"
                Grid.Row="4" />
            <!--#endregion-->

            <!--  ******************  -->
            <!--#region CARD LAYOUT 01 - DATAGRID-->
            <!--  Heading with error box  -->
            <Border
                x:Name="Error_Panel"
                Grid.Row="1"
                Style="{DynamicResource CustomBorder_03}"
                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
                <StackPanel >
                    <TextBlock Style="{DynamicResource CustomTextBlock_ErrorTitle}" Text="Error " />
                    <TextBox
                        x:Name="ErrorTextBox"
                        MaxHeight="100"
                        Style="{DynamicResource CustomTextBox_Error}"
                        Text="{Binding ErrorTextBoxDataFill, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Border>

            <!--  Preview DataGrid  -->
            <DataGrid
                x:Name="PreviewDataGrid"
                Grid.Row="2"
                Margin="12"
                AutoGenerateColumns="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                FrozenColumnCount="2"
                ItemsSource="{Binding DataViewDataTable.DefaultView}"
                Style="{DynamicResource CustomDataGrid-03}" />
            <!--#endregion-->

            <!--  ******************  -->
            <!--#region Window process options-->
            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="26"
                    Padding="20,0"
                    Click="ButtonEvent_Preview_GoBack"
                    Content="Go Back"
                    Style="{DynamicResource CustomButton_01}" />
                <Button
                    x:Name="PreviewButtonApply"
                    Margin="10,0,10,0"
                    Padding="20,0"
                    Click="ButtonEvent_Preview_Apply"
                    Content="Apply"
                    IsEnabled="{Binding IsApplyButtonVisible}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CustomButton_01}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                    <Setter Property="Visibility" Value="Visible" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button
                    Height="26"
                    Padding="20,0"
                    Click="ButtonEvent_Preview_Cancel"
                    Content="Cancel"
                    Style="{DynamicResource CustomButton_01}" />
            </StackPanel>
            <!--#endregion-->
        </Grid>
    </Border>
</Window>
