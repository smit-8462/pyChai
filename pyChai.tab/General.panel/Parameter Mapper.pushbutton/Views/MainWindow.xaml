<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="MainWindow"
    Width="800"
    Height="600"
    MinWidth="800"
    MinHeight="600"
    mc:Ignorable="d"
    Background="Transparent"
    AllowsTransparency="True"
    WindowStyle="None"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <!--  Window Customize  -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CornerRadius="12"
            GlassFrameThickness="0"
            NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Border Style="{DynamicResource CustomBorder_Window}">
        <!--  For correctly render window border, we have made background transparent  -->
        <Grid x:Name="root_grid" Background="Transparent">
            <!--  Creating rows & columns  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <!--#region TOP WINDOW BAR-->
            <Grid
                x:Name="window_top_bar_uc"
                Grid.Row="0" />
            <!--#endregion-->
            <!--  ************************************  -->

            <!--#region BOTTOM WINDOW FOOTER-->
            <Grid
                x:Name="window_bottom_bar_uc"
                Grid.Row="4" />
            <!--#endregion-->
            <!--  ************************************  -->

            <!--#region CARD LAYOUT 01 - SELECTION-->
            <!--  Card Background  -->
            <Border
                Grid.Row="1"
                Margin="12"
                Style="{DynamicResource CustomBorder_01}">
                <Grid
                    Margin="12"
                    VerticalAlignment="Top"
                    Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>

                    <!--  Select Category  -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" SharedSizeGroup="ColumnGroup1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" SharedSizeGroup="ColumnGroup2" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{DynamicResource CustomTextBlock_SelectionLabelText}"
                            Text="Select Category :" />
                        <ComboBox
                            x:Name="mw_category_picker"
                            Grid.Column="1"
                            Margin="8,0,8,0"
                            ItemsSource="{Binding CategorySelection.CategoryItems}"
                            DisplayMemberPath="CatName"
                            SelectionChanged="ComboBox_Category_SelectionChanged"
                            Style="{DynamicResource CustomComboBox}" />
                            <!-- SelectedItem="{Binding CategorySelection.SelectedCategory, Mode=TwoWay}" -->
                        <!--  Discard button  -->
                        <Button
                            Grid.Column="2"
                            Click="ButtonEvent_Main_Clear"
                            ToolTip="Discard">
                            <!-- Visibility control -->
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CustomButton_01}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CategorySelection.SelectedCategory}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CategorySelection.SelectedCategory}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ContentControl
                                Width="14"
                                Height="14"
                                Style="{DynamicResource IconControlStyle}"
                                Tag="{DynamicResource icon_clear}" />
                        </Button>
                    </Grid>

                    <!--  Load File  -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup2" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Style="{DynamicResource CustomTextBlock_SelectionLabelText}"
                            Text="Load File :" />
                        <Button
                            Grid.Column="1"
                            Margin="8,0,8,0"
                            Click="ButtonEvent_Main_PickFile"
                            Style="{DynamicResource CustomButton_01}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <ContentControl
                                    Width="14"
                                    Height="14"
                                    Style="{DynamicResource IconControlStyle}"
                                    Tag="{DynamicResource icon_file}" />
                                <TextBlock
                                    x:Name="mw_pickfile_text"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource CustomTextBlock_Button02}"
                                    Text="{Binding FileSelection.SelectedFileText}" />
                            </StackPanel>
                        </Button>
                        <!--  Refresh button  -->
                        <Button
                            Grid.Column="2"
                            Click="ButtonEvent_Main_RefreshContent"
                            ToolTip="Refresh">
                            <!-- Visibility control -->
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CustomButton_01}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FileSelection.SelectedFilePath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FileSelection.SelectedFilePath}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ContentControl
                                Width="14"
                                Height="14"
                                Style="{DynamicResource IconControlStyle}"
                                Tag="{DynamicResource icon_refresh}" />
                        </Button>
                    </Grid>

                    <!--  File Extension Tag Highlight  -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup2" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="1"
                            Margin="8,2,8,2"
                            IsHitTestVisible="False"
                            Orientation="Horizontal">
                            <RadioButton
                                x:Name="ExtensionTag_Excel"
                                Content="Excel"
                                GroupName="FileType"
                                IsChecked="{Binding FileSelection.SelectedFileExtension,
                                    Converter={StaticResource FileExtensionConverter},
                                    ConverterParameter=.xlsx|.xls|.xlsm|.xlsb, Mode=TwoWay}"
                                Style="{DynamicResource RadioChip}" />
                            <RadioButton
                                x:Name="ExtensionTag_Calc"
                                Margin="8,0,8,0"
                                Content="LibreOffice Calc"
                                GroupName="FileType"
                                IsChecked="{Binding FileSelection.SelectedFileExtension,
                                    Converter={StaticResource FileExtensionConverter},
                                    ConverterParameter=.ods, Mode=TwoWay}"
                                Style="{DynamicResource RadioChip}" />
                            <RadioButton
                                x:Name="ExtensionTag_CSV"
                                Content="CSV"
                                GroupName="FileType"
                                IsChecked="{Binding FileSelection.SelectedFileExtension,
                                    Converter={StaticResource FileExtensionConverter},
                                    ConverterParameter=.csv, Mode=TwoWay}"
                                Style="{DynamicResource RadioChip}" />
                        </StackPanel>
                    </Grid>

                    <!--  Element Selection  -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup2" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Style="{DynamicResource CustomTextBlock_SelectionLabelText}"
                            Text="Select Elements :" />

                        <!--  Select manual  -->
                        <Button
                            Grid.Column="1"
                            Margin="8,0,4,0"
                            Click="ButtonEvent_Main_SelectManual"
                            Style="{DynamicResource CustomButton_01}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <ContentControl
                                    Width="14"
                                    Height="14"
                                    Style="{DynamicResource IconControlStyle}"
                                    Tag="{DynamicResource icon_select_multiple}" />
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource CustomTextBlock_Button02}"
                                    Text="Manual Selection" />
                            </StackPanel>
                        </Button>

                        <!--  Select all  -->
                        <Button
                            Grid.Column="2"
                            Margin="4,0,8,0"
                            Click="ButtonEvent_Main_SelectAll"
                            Style="{DynamicResource CustomButton_01}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <ContentControl
                                    Width="14"
                                    Height="14"
                                    Style="{DynamicResource IconControlStyle}"
                                    Tag="{DynamicResource icon_select_all}" />
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource CustomTextBlock_Button02}"
                                    Text="Select All" />
                            </StackPanel>
                        </Button>

                        <Button
                            Grid.Column="3"
                            Click="ButtonEvent_Main_SelectClear"
                            ToolTip="Clear selection">
                            <!-- Visibility control -->
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CustomButton_01}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementSelection.ElementsTotal}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ContentControl
                                Width="14"
                                Height="14"
                                Style="{DynamicResource IconControlStyle}"
                                Tag="{DynamicResource icon_clear}" />
                        </Button>
                    </Grid>

                    <!--  Swlwcted Elements Information  -->
                    <Grid Grid.Row="4" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColumnGroup2" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="2"
                            Height="26"
                            VerticalAlignment="Top"
                            Click="ButtonEvent_Main_ShowError"
                            ToolTip="Click to see error report">
                            <!-- Visibility to control error report. Anyways, the errors gets reset when HasPreviewWindowOpened is None. -->
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CustomButton_01}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementSelection.HasPreviewWindowOpened}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ContentControl
                                Width="14"
                                Height="14"
                                Style="{DynamicResource IconControlStyle}"
                                Tag="{DynamicResource icon_error}" />
                        </Button>

                        <Border
                            Grid.Column="1"
                            Margin="8,0,8,0"
                            ClipToBounds="True"
                            Style="{DynamicResource CustomBorder_02}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Grid Borders  -->
                                <Border
                                    Grid.Row="0"
                                    Grid.ColumnSpan="3"
                                    Background="{DynamicResource theme_datagrid_header_bg}"
                                    BorderBrush="{DynamicResource theme_button_border}"
                                    BorderThickness="0,0,0,2"
                                    CornerRadius="7,7,0,0" />
                                <Border
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    BorderBrush="{DynamicResource theme_button_border}"
                                    BorderThickness="1,0,1,0" />

                                <!--  Headers  -->
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{DynamicResource CustomTextBlock_TableHeader}"
                                    Text="Total" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{DynamicResource CustomTextBlock_TableHeader}"
                                    Text="Success" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Style="{DynamicResource CustomTextBlock_TableHeader}"
                                    Text="Failed" />

                                <!--  Content  -->
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    FontWeight="Normal"
                                    Style="{DynamicResource CustomTextBlock_TableHeader}"
                                    Text="{Binding ElementSelection.ElementsTotal}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontWeight="Normal"
                                    Style="{DynamicResource CustomTextBlock_TableHeader}"
                                    Text="{Binding ElementSelection.ElementsSuccess}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    FontWeight="Normal"
                                    Style="{DynamicResource CustomTextBlock_TableHeader}"
                                    Text="{Binding ElementSelection.ElementsFailed}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <!--#endregion-->
            <!--  ************************************  -->

            <!--#region Card Layout 02 - Parameter Mapping Grid-->
            <Border
                Grid.Row="2"
                Margin="12"
                Style="{DynamicResource CustomBorder_01}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="12,8,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="30,0,0,0"
                            Style="{DynamicResource CustomTextBlock_ChoicesHeader}"
                            Text="Sorting" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource CustomTextBlock_ChoicesHeader}"
                            Text="Revit Parameter" />
                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            Style="{DynamicResource CustomTextBlock_ChoicesHeader}"
                            Text="Spreadsheet Column" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" Style="{DynamicResource CustomScrollView_Choices}">
                        <ItemsControl x:Name="option_rows" ItemsSource="{Binding ChoicesVM.ChoiceRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:Name="ChoicesRowTemplate">
                                    <Border Margin="0,0,0,8" Style="{DynamicResource CustomBorder_02}">
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <!--  S. No.  -->
                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="12,0,0,0"
                                                Style="{DynamicResource CustomTextBlock_ChoicesNumber}"
                                                Text="{Binding SerialNumber}" />

                                            <!--  Primary sorting column  -->
                                            <RadioButton
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                GroupName="Sorting_Group"
                                                IsChecked="{Binding PrimarySort}"
                                                Style="{DynamicResource CustomRadioButton_Choices}" />

                                            <!--  Type of Revit Parameter  -->
                                            <Label
                                                x:Name="rvt_project_type"
                                                Grid.Column="2"
                                                Margin="16,4"
                                                Style="{DynamicResource ParameterTypeTag}" />

                                            <!--  Revit Parameter  -->
                                            <ComboBox
                                                Grid.Column="3"
                                                Margin="0,4,0,4"
                                                SelectedItem="{Binding RevitParameterValue}"
                                                SelectionChanged="ComboBox_RevitParameter_SelectionChanged"
                                                ItemsSource="{Binding DataContext.ChoicesVM.RevitParameterList, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Style="{DynamicResource CustomComboBox}" />

                                            <!--  Mapping Symbol  -->
                                            <StackPanel
                                                Grid.Column="4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <ContentControl
                                                    Width="24"
                                                    Height="24"
                                                    Foreground="{DynamicResource theme_icon}"
                                                    Style="{DynamicResource IconControlStyle}"
                                                    Tag="{DynamicResource icon_mapping}" />
                                            </StackPanel>

                                            <!--  Excel Column  -->
                                            <ComboBox
                                                Grid.Column="5"
                                                Margin="0,4,12,4"
                                                SelectedItem="{Binding ExcelColumnValue}"
                                                SelectionChanged="ComboBox_ExcelColumn_SelectionChanged"
                                                ItemsSource="{Binding DataContext.ChoicesVM.ExcelColumnList, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Style="{DynamicResource CustomComboBox}" />

                                            <!--  Add Rows  -->
                                            <!--  Passing whole row by using only Binding in CommandParameter  -->
                                            <Button
                                                x:Name="add_row_button"
                                                Grid.Column="6"
                                                Margin="0,4,8,4"
                                                Padding="0"
                                                Command="{Binding DataContext.ChoicesVM.Command_AddRow, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource CustomButton_01}">
                                                <ContentControl
                                                    Width="14"
                                                    Height="14"
                                                    Style="{DynamicResource IconControlStyle}"
                                                    Tag="{DynamicResource icon_add}" />
                                            </Button>

                                            <!--  Remove Rows  -->
                                            <Button
                                                x:Name="remove_row_button"
                                                Grid.Column="7"
                                                Margin="0,4"
                                                Padding="0"
                                                Command="{Binding DataContext.ChoicesVM.Command_DeleteRow, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.ChoicesVM.CanDeleteRow, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Style="{DynamicResource CustomButton_01}">
                                                <ContentControl
                                                    Width="14"
                                                    Height="14"
                                                    Style="{DynamicResource IconControlStyle}"
                                                    Tag="{DynamicResource icon_delete}" />
                                            </Button>

                                            <!--  Validation Button Indication (Tick/Warning icon)  -->
                                            <Label
                                                x:Name="row_correct"
                                                Grid.Column="8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ShowCorrectIcon}">
                                                <ContentControl
                                                    Width="24"
                                                    Height="24"
                                                    Foreground="{DynamicResource theme_label_cardtag_fg02}"
                                                    Style="{DynamicResource IconControlStyle}"
                                                    Tag="{DynamicResource icon_correct}" />
                                            </Label>

                                            <Label
                                                x:Name="row_incorrect"
                                                Grid.Column="8"
                                                Margin="0,0,4,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ShowErrorIcon}"
                                                ToolTip="{Binding ErrorTooltip}">
                                                <ContentControl
                                                    Width="24"
                                                    Height="24"
                                                    Foreground="{DynamicResource theme_label_cardtag_fg03}"
                                                    Style="{DynamicResource IconControlStyle}"
                                                    Tag="{DynamicResource icon_warning_info}" />
                                            </Label>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            <!--#endregion-->
            <!--  ************************************  -->

            <!--#region  Window process options-->
            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="26"
                    Padding="20,0"
                    Click="ButtonEvent_Main_Cancel"
                    Content="Cancel"
                    Style="{DynamicResource CustomButton_01}" />
                <Button
                    Margin="10,0,0,0"
                    Padding="20,0"
                    Click="ButtonEvent_Main_PreviewContent"
                    Content="Generate Mapping"
                    IsEnabled="{Binding ChoicesVM.IsButtonEnabled}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CustomButton_01}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                    <Setter Property="Visibility" Value="Visible" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <!--#endregion-->
        </Grid>
    </Border>
</Window>
